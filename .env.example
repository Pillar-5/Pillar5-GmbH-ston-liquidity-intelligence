# STON.fi Liquidity & Execution Intelligence Engine - configuration example.
# Copy to `.env` and adjust as needed. All values are optional and have sane defaults.

# STON.fi public HTTP API base URL
STONFI_API_BASE_URL=https://api.ston.fi

# Where to store local SQLite data
STONFI_DB_PATH=data/liquidity.db

# Directory for generated reports
STONFI_REPORT_DIR=reports

# Wallet address that owns the STON.fi API key (currently the public API does not
# require authentication, but plans for a gated API exist). Leave blank if unused.
STONFI_API_KEY=

# HTTP client tuning
STONFI_TIMEOUT_SECONDS=30.0
STONFI_MAX_CONCURRENCY=8
STONFI_MAX_RETRIES=2

# Market-universe selection: only keep pools that involve TON and have at least
# this much total liquidity (USD). Then keep the top N liquid pools.
STONFI_MIN_POOL_TVL_USD=50000
STONFI_MAX_POOLS=12

# Simulated swap trade sizes, expressed as fractions of the pool's base reserve.
STONFI_TRADE_SIZES=0.0001,0.001,0.005,0.01,0.02,0.05

# Slippage tolerance passed to the STON.fi swap simulation (fraction).
STONFI_SLIPPAGE_TOLERANCE=0.01

# Reference carbon-copy: when evaluating execution quality, treat the smallest
# simulated trade as the no/low-impact reference price.